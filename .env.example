# Required for image captioning, answering, and RAGAS evaluation.
OPENAI_API_KEY=replace_me

# API / storage
HOST=0.0.0.0
PORT=8000
QDRANT_URL=http://localhost:6333
# Leave blank for local Qdrant; set this for Qdrant Cloud.
QDRANT_API_KEY=
QDRANT_COLLECTION=docmind_v2
DOCUMENT_STORE_PATH=data/documents.json
UPLOAD_DIR=data/uploads
FRONTEND_ORIGIN=*

# Retrieval / model settings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
CHAT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SPARSE_WEIGHT=0.4
DENSE_WEIGHT=0.6
RERANK_TOP_N=3

# Evaluation pass thresholds (0 to 1)
EVAL_FAITHFULNESS_MIN=0.75
EVAL_ANSWER_RELEVANCY_MIN=0.75
EVAL_CONTEXT_PRECISION_MIN=0.70
EVAL_CONTEXT_RECALL_MIN=0.70
